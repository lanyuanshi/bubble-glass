from ui.settings import Divider, Header, Input, Selector, Switch, Text

try:
    from ui.settings import Slider
except ImportError:
    Slider = None

__id__ = "bubble_glass"
__name__ = "Frost Evening Verse（霜晚辞）"
__description__ = "玻璃质感气泡与页面壁纸，联系人分组、防撤回、内容保护截图下载"
