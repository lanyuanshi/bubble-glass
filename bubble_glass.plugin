PAGE_BY_CLASS = {p[2]: p[0] for p in PAGES}
CHAT_GIF_CODE = 26474
PAGE_HINTS = {
    "home": "对话列表、顶栏和文件夹标签盖在壁纸上的那层底色有多透。",
    "contacts": "联系人列表底色和卡片有多透。",
    "settings": "设置页底色和卡片有多透。",
}
HOME_GLASS_PANELS = (
    "org.telegram.ui.Components.FilterTabsView",
    "org.telegram.ui.Components.DialogsActivityTopPanelLayout",
)

