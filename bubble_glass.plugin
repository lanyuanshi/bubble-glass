}

BACKDROP_SCALE = 1.0 / 6.0
BACKDROP_CHECK_INTERVAL = 0.3
BACKDROP_MIN_REBUILD_INTERVAL = 0.5


def _signed(color):
    return color - 0x100000000 if color > 0x7FFFFFFF else color


def _with_alpha(color, alpha):
    return _signed((max(0, min(255, int(alpha))) << 24) | (color & 0x00FFFFFF))


def _java_class(name):
    from java.lang import Class
    from org.telegram.messenger import ApplicationLoader
    return Class.forName(name, False, ApplicationLoader.applicationContext.getClassLoader())


class _DrawHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        self.plugin._before_draw(param)

    def after_hooked_method(self, param):
        self.plugin._after_draw(param)


class _ShadowHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if self.plugin._active():
            param.setResult(None)


class _VisibleHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        self.plugin._on_visible(param)


class _Hook(MethodHook):
    def __init__(self, before=None, after=None):
        self._before = before
        self._after = after

    def before_hooked_method(self, param):
        if self._before is not None:
            self._before(param)

    def after_hooked_method(self, param):
        if self._after is not None:
            self._after(param)


class BubbleGlassPlugin(BasePlugin):
    def on_plugin_load(self):
        from android.graphics import Matrix, Paint

        self._cfg = dict(DEFAULTS)
        self._reported = set()
        self._layers = []
        self._frost_paint = Paint(Paint.ANTI_ALIAS_FLAG | Paint.FILTER_BITMAP_FLAG)
        self._tint_paint = Paint(Paint.ANTI_ALIAS_FLAG)
        self._stroke_paint = Paint(Paint.ANTI_ALIAS_FLAG)
        self._stroke_paint.setStyle(Paint.Style.STROKE)
        self._matrix = Matrix()
        self._bd_shader = None
        self._bd_base = None
        self._bd_key = None
        self._bd_checked = 0.0
        self._bd_built = 0.0
        self._is_out_field = None
        self._bg_view = None
        self._bd_gen = 0
        self._list_off = (0, 0)
        self._cell_state = {}
        self._views = {}
        self._frags = {}
        self._cache = {}
        self._bitmaps = {}
        self._gen = {}
        self._fade_saves = []
        self._card_saves = []
        self._seen = set()
        self._bar_classes = set()
        self._search_bg = None
        self._reload_cfg()
        self._ar_init()

        try:
            drawable_cls = _java_class("org.telegram.ui.ActionBar.MessageDrawable")
            draw = drawable_cls.getDeclaredMethod(
                "draw", _java_class("android.graphics.Canvas"), _java_class("android.graphics.Paint"))
            self._is_out_field = drawable_cls.getDeclaredField("isOut")
            self._is_out_field.setAccessible(True)
            self.hook_method(draw, _DrawHook(self))
            self.hook_method(drawable_cls.getDeclaredMethod("getShadowDrawable"), _ShadowHook(self))
        except Exception:
            self._log_error("Failed to hook MessageDrawable")
        try:
            self.hook_all_methods(_java_class("org.telegram.ui.Cells.ChatMessageCell"),
                                  "setVisiblePart", _VisibleHook(self))
        except Exception:
            self._log_error("Failed to hook ChatMessageCell.setVisiblePart")
        self._hook_pages()
        self._cg_init()
        self._hook_contacts()
        self._hook_noforwards()
        self._music_init()
        self._hook_music()

    def on_plugin_unload(self):
        self._cg_unload()
        self._music_unload()
        self._bd_shader = None
        self._bg_view = None
        self._cell_state = {}
        entries = list(self._views.values())
        self._views = {}
        self._frags = {}
        self._cache = {}
        self._bitmaps = {}

        def restore():
            for page, view in entries:
                self._detach_home(view)
                try:
                    self._apply_glass_alpha(page, view, False)
                except Exception:
                    pass
        self._ui(restore)

    # ---------- settings ----------

    def _reload_cfg(self):
        cfg = {}
        for key, default in DEFAULTS.items():
            value = self.get_setting(key, default)
            if key in SLIDERS and Slider is None:
                steps = SLIDERS[key][5]
                idx = self.get_setting(key + "_idx", None)
                if isinstance(idx, int) and 0 <= idx < len(steps):
                    value = steps[idx]
            cfg[key] = value
        self._apply_cfg(cfg)

    def _apply_cfg(self, cfg):
        try:
            self._cfg = {
                "enabled": bool(cfg["enabled"]),
                "style": int(cfg["style"]) if 0 <= int(cfg["style"]) < len(STYLE_ITEMS) else STYLE_AUTO,
                "transparency": max(0.0, min(100.0, float(cfg["transparency"]))),
                "blur": int(max(0, min(25, float(cfg["blur"])))),
                "density": max(0.0, min(100.0, float(cfg["density"]))),
                "outline": bool(cfg["outline"]),
                "allow_noforwards": bool(cfg["allow_noforwards"]),
                "music_player": bool(cfg["music_player"]),
            }
            for page in PAGE_INFO:
                mode = int(cfg[page + "_mode"])
                self._cfg[page + "_mode"] = mode if 0 <= mode < len(HOME_ITEMS) else HOME_OFF
                self._cfg[page + "_transparency"] = max(0.0, min(100.0, float(cfg[page + "_transparency"])))
        except Exception:
            self._cfg = dict(DEFAULTS)

    def _on_change(self, key, value):
        cfg = dict(self._cfg)
        if key.endswith("_idx"):
            key = key[:-4]
            value = SLIDERS[key][5][int(value)]
        cfg[key] = value
        self._apply_cfg(cfg)
        page = key.split("_")[0]
        if page in PAGE_INFO:
            self._refresh_page(page)

    def _apply_preset(self, style):
        values = PRESETS[style]
        for key, value in values.items():
            self.set_setting(key, value)
            if key in SLIDERS and Slider is None:
                steps = SLIDERS[key][5]
                self.set_setting(key + "_idx", min(range(len(steps)), key=lambda i: abs(steps[i] - value)))
        self._reload_cfg()
        self.set_setting("style", values["style"], reload_settings=True)

    def _slider_row(self, key):
        title, sub, icon, lo, hi, steps = SLIDERS[key]
        if Slider is not None:
            return Slider(key=key, text=title, default=DEFAULTS[key], min=lo, max=hi, step=1,
                          subtext=sub, icon=icon, on_change=lambda v, k=key: self._on_change(k, v))
        default_idx = min(range(len(steps)), key=lambda i: abs(steps[i] - DEFAULTS[key]))
        return Selector(key=key + "_idx", text=title, default=default_idx,
                        items=[str(s) for s in steps], icon=icon,
                        on_change=lambda v, k=key: self._on_change(k + "_idx", v))

    def create_settings(self):
        return [
            Header(text="Frost Evening Verse（霜晚辞）"),
            Header(text="气泡玻璃"),
            Switch(key="enabled", text="启用", default=DEFAULTS["enabled"], icon="msg_customize",
                   on_change=lambda v: self._on_change("enabled", v)),
            Selector(key="style", text="风格", default=DEFAULTS["style"], items=STYLE_ITEMS,
                     icon="msg_theme", on_change=lambda v: self._on_change("style", v)),
            self._slider_row("transparency"),
            self._slider_row("blur"),
            self._slider_row("density"),
            Switch(key="outline", text="玻璃描边", default=DEFAULTS["outline"],
                   subtext="在气泡边缘画一圈细高光", icon="msg_photo_settings",
                   on_change=lambda v: self._on_change("outline", v)),
            Header(text="一键预设"),
            Text(text="晴空", subtext="明亮通透的浅色毛玻璃", icon="msg_brightness_high",
                 on_click=lambda *_: self._apply_preset(STYLE_CLEAR)),
            Text(text="夜幕", subtext="深色低调的暗色玻璃", icon="msg_brightness_low",
                 on_click=lambda *_: self._apply_preset(STYLE_NIGHT)),
            Divider(text="模糊取自当前聊天壁纸。改完设置后返回聊天即可看到效果。"),
            Text(text="页面壁纸与透明度", subtext="主页 / 联系人 / 设置 各自的壁纸和透明度",
                 icon="msg_background", accent=True, create_sub_fragment=self._page_sub_rows),
        ] + self._cg_rows() + self._ar_rows() + self._nf_rows() + self._music_rows()

    def _page_sub_rows(self):
        rows = []
        for page, _, _, _ in PAGES:
            rows += self._page_rows(page)
        return rows

    def _page_rows(self, page):
        label = PAGE_INFO[page][1]
        return [
            Header(text=label),
            Selector(key=page + "_mode", text=label + "壁纸", default=DEFAULTS[page + "_mode"], items=HOME_ITEMS,
                     icon="msg_background", on_change=lambda v, k=page + "_mode": self._on_change(k, v)),
            Text(text="选择图片…", subtext="从相册选一张图作为%s壁纸" % label, icon="msg_gallery",
                 on_click=lambda *_, pg=page: self._pick_image(pg)),
            self._slider_row(page + "_transparency"),
            Divider(text=PAGE_HINTS[page]),
        ]

    # ---------- anti-recall ----------

    def _ar_rows(self):
        return [
            Header(text="防撤回"),
            Switch(key="anti_recall", text="防撤回", default=self._ar_enabled(), icon="msg_delete",
                   subtext="被撤回的消息保留在聊天里并加标记，不再直接消失",
                   on_change=lambda v: self._ar_apply(v)),
            Switch(key="anti_recall_bots", text="包括机器人消息", default=self._ar_bots(), icon="msg_users",
                   subtext="机器人发的消息被撤回时也保留",
                   on_change=lambda v: self._ar_apply_bots(v)),
            Switch(key="anti_recall_icon", text="使用图标", default=self._ar_icon(), icon="msg_edit",
                   subtext="开启显示垃圾桶图标；关闭后才显示下面的自定义文字",
                   on_change=lambda v: self._ar_apply_icon(v)),
            Input(key="anti_recall_mark", text="撤回标记", default=self._ar_mark(), icon="msg_edit",
                  subtext="「使用图标」关闭时才生效，显示在被撤回消息时间旁；留空用客户端默认",
                  on_change=lambda v: self._ar_apply_mark(v)),
            Divider(text="基于客户端的「保存已删除消息」能力：消息内容保留，时间旁显示标记。"),
        ]

    @staticmethod
    def _naconfig(getter):
        # NaConfig (NagramX) is a Kotlin object; its Java getter returns the ConfigItem.
        try:
            from xyz.nextalone.nagram import NaConfig
            return getattr(NaConfig.INSTANCE, getter)()
        except Exception:
            return None

    def _ar_read_bool(self, getter):
        item = self._naconfig(getter)
        try:
            return bool(item.Bool()) if item is not None else False
        except Exception:
            return False

    def _ar_enabled(self):
        return self._ar_read_bool("getEnableSaveDeletedMessages")

    def _ar_bots(self):
        return self._ar_read_bool("getSaveDeletedMessageForBotUser")

    def _ar_mark(self):
        item = self._naconfig("getCustomDeletedMark")
        try:
            return str(item.String()) if item is not None else ""
        except Exception:
            return ""

    def _ar_apply(self, on):
        item = self._naconfig("getEnableSaveDeletedMessages")
        if item is not None:
            try:
                item.setConfigBool(bool(on))
            except Exception:
                self._report("anti_recall")

    def _ar_apply_bots(self, on):
        item = self._naconfig("getSaveDeletedMessageForBotUser")
        if item is not None:
            try:
                item.setConfigBool(bool(on))
            except Exception:
                self._report("anti_recall_bots")

    def _ar_icon(self):
        return self._ar_read_bool("getUseDeletedIcon")

    def _ar_apply_icon(self, on):
        item = self._naconfig("getUseDeletedIcon")
        if item is not None:
            try:
                item.setConfigBool(bool(on))
            except Exception:
                self._report("anti_recall_icon")

    def _ar_apply_mark(self, mark):
        item = self._naconfig("getCustomDeletedMark")
        if item is not None:
            try:
                item.setConfigString("" if mark is None else str(mark))
            except Exception:
                self._report("anti_recall_mark")

    # ---------- content protection ----------

    def _nf_rows(self):
        return [
            Header(text="内容保护"),
            Switch(key="allow_noforwards", text="允许截图和下载", default=DEFAULTS["allow_noforwards"],
                   subtext="在开启「禁止截图和转发」的群组/频道里也能截图、保存媒体",
                   on_change=lambda v: self._on_change("allow_noforwards", v)),
            Divider(text="只影响本机的显示与保存；转发仍受服务端限制，秘密聊天不受影响。"),
        ]

    def _hook_noforwards(self):
        hook = _Hook(after=self._on_noforwards)
        self._try_hook("org.telegram.messenger.MessagesController", "isChatNoForwards", hook, quiet=True)
        self._try_hook("org.telegram.messenger.MessagesController", "isUserNoForwards", hook, quiet=True)

    def _on_noforwards(self, param):
        if self._cfg.get("allow_noforwards"):
            param.setResult(False)

    def _ar_init(self):
        # Only touch the client's own config for values the user actually set in
        # this plugin, so we never clobber exteraless' experimental settings.
        try:
            for key, apply in (("anti_recall", self._ar_apply), ("anti_recall_bots", self._ar_apply_bots),
                               ("anti_recall_icon", self._ar_apply_icon)):
                value = self.get_setting(key, None)
                if value is not None:
                    apply(self._cg_on(value))
            mark = self.get_setting("anti_recall_mark", None)
            if mark is not None:
                self._ar_apply_mark(mark)
        except Exception:
            self._report("anti_recall_init")

    # ---------- page wallpapers (home / contacts / settings) ----------

    @staticmethod
    def _ui(fn, delay=0):
        try:
            from android_utils import run_on_ui_thread
            run_on_ui_thread(fn, delay)
        except Exception:
            fn()

    @staticmethod
    def _ident(obj):
        from java.lang import System
        return System.identityHashCode(obj)

    def _page_on(self, page):
        return self._cfg[page + "_mode"] != HOME_OFF

    def _page_alpha(self, page):
        return int(255 * (100.0 - self._cfg[page + "_transparency"]) / 100.0)

    def _page_of(self, view):
        if view is None or not self._views:
            return None
        entry = self._views.get(self._ident(view))
        return entry[0] if entry is not None else None

    def _try_hook(self, cls_name, method, hook, quiet=False):
        try:
            self.hook_all_methods(_java_class(cls_name), method, hook)
            return True
        except Exception:
            if quiet:
                self._log_info("skip hook %s.%s (not in this build)" % (cls_name, method))
            else:
                self._log_error("Failed to hook %s.%s" % (cls_name, method))
            return False

    def _page_of_parents(self, view, depth=4):
        # Page that owns `view`, looking a few levels up the view tree.
        if not self._views:
            return None
        for _ in range(depth):
            if view is None:
                return None
            page = self._page_of(view)
            if page is not None:
                return page
            view = view.getParent()
        return None

    def _hook_pages(self):
        for page, _, cls_name, _ in PAGES:
            self._try_hook(cls_name, "createView",
                           _Hook(after=lambda p, pg=page: self._on_page_created(pg, p)))
            self._try_hook(cls_name, "onFragmentDestroy", _Hook(before=self._on_page_destroyed))
        layout = "org.telegram.ui.Components.SizeNotifierFrameLayout"
        self._try_hook(layout, "getNewDrawable", _Hook(after=self._on_get_new_drawable))
        self._try_hook(layout, "dispatchDraw", _Hook(before=self._on_layout_draw))
        self._try_hook(layout, "getNewDrawableMotion", _Hook(after=self._on_get_new_motion))
        # Action bars with an adaptive background (contacts) go through the base
        # drawBlurRect() overloads rather than the page's own override.
        self._try_hook(layout, "drawBlurRect", _Hook(before=self._on_draw_bar), quiet=True)
        if self._try_hook("org.telegram.ui.DialogsActivity$ContentView", "drawBlurRect",
                          _Hook(before=self._on_draw_bar)):
            self._bar_classes.add("org.telegram.ui.DialogsActivity$ContentView")
        self._try_hook("org.telegram.ui.Components.DialogsActivityTopBubblesFadeView", "onDraw",
                       _Hook(before=self._before_fade, after=self._after_fade))
        # Section cards: newer builds draw them in BitmapSectionsItemDecoration,
        # older ones (13.1.x) in RecyclerListView itself. Either may be missing.
        self._try_hook("org.telegram.ui.Components.BitmapSectionsItemDecoration", "onDraw",
                       _Hook(before=self._before_cards, after=self._after_cards), quiet=True)
        self._try_hook("org.telegram.ui.Components.RecyclerListView", "drawSectionsBackgrounds",
                       _Hook(before=self._before_list_cards, after=self._after_cards), quiet=True)
        try:
            self._search_bg = _java_class(
                "org.telegram.ui.Components.FragmentSearchField").getDeclaredField("bg")
            self._search_bg.setAccessible(True)
            self._try_hook("org.telegram.ui.Components.FragmentSearchField", "dispatchDraw",
                           _Hook(before=self._on_search_field), quiet=True)
        except Exception:
            self._log_info("skip search field (not in this build)")
        self._try_hook("org.telegram.ui.LaunchActivity", "onActivityResult",
                       _Hook(before=self._on_activity_result))
        # Plugins start asynchronously, so these screens usually exist already.
        self._ui(self._initial_scan)

    def _initial_scan(self):
        self._scan_pages()
        for page, _, _, _ in PAGES:
            if self._page_on(page):
                self._refresh_page(page)

    def _scan_pages(self):
        try:
            from org.telegram.ui import LaunchActivity

            activity = LaunchActivity.instance
            if activity is None:
                return
            layouts = [activity.getActionBarLayout()]
            for name in ("getLayersActionBarLayout", "getRightActionBarLayout"):
                try:
                    layouts.append(getattr(activity, name)())
                except Exception:
                    pass
            for layout in layouts:
                if layout is None:
                    continue
                stack = layout.getFragmentStack()
                for i in range(stack.size()):
                    self._scan_fragment(stack.get(i))
            self._log_info("page views: %s" % sorted(p for p, _ in self._views.values()))
        except Exception:
            self._report("scan_pages")

    def _scan_fragment(self, fragment):
        if fragment is None:
            return
        if str(fragment.getClass().getName()) == "org.telegram.ui.MainTabsActivity":
            try:
                arr_field = _java_class("org.telegram.ui.ViewPagerActivity").getDeclaredField("fragmentsArr")
                arr_field.setAccessible(True)
                frag_field = _java_class("org.telegram.ui.ViewPagerActivity$FragmentState").getDeclaredField("fragment")
                frag_field.setAccessible(True)
                arr = arr_field.get(fragment)
                for j in range(arr.size()):
                    self._scan_fragment(frag_field.get(arr.valueAt(j)))
            except Exception:
                self._report("scan_tabs")
                self._scan_fragment(fragment.getDialogsActivity())
            return
        page = self._page_for_fragment(fragment)
        if page is not None:
            self._register(page, fragment, fragment.getFragmentView())

    @staticmethod
    def _page_for_fragment(fragment):
        cls = fragment.getClass()
        for _ in range(3):
            if cls is None:
                break
            page = PAGE_BY_CLASS.get(str(cls.getName()))
            if page is not None:
                return page
            cls = cls.getSuperclass()
        return None

    def _register(self, page, fragment, view):
        from java import cast
        from org.telegram.ui.Components import SizeNotifierFrameLayout

        if view is None or not isinstance(view, SizeNotifierFrameLayout):
            return None
        view = cast(SizeNotifierFrameLayout, view)
        view_id = self._ident(view)
        self._views[view_id] = (page, view)
        self._hook_bar(view)
        if fragment is not None:
            self._frags[self._ident(fragment)] = view_id
        return view

    def _hook_bar(self, view):
        # Each page draws its top bar through its own drawBlurRect() override
        # (an anonymous class such as ContactsActivity$5), so hook it by instance.
        try:
            cls = view.getClass()
            name = str(cls.getName())
            if name in self._bar_classes:
                return
            self._bar_classes.add(name)
            if name == "org.telegram.ui.Components.SizeNotifierFrameLayout":
                return
            self.hook_all_methods(cls, "drawBlurRect", _Hook(before=self._on_draw_bar))
        except Exception:
            self._log_info("skip top bar hook")

    def _on_page_created(self, page, param):
        try:
            view = self._register(page, param.thisObject, param.getResult())
            if view is not None and self._page_on(page):
                self._attach_home(view)
                self._apply_glass_alpha(page, view, True)
        except Exception:
            self._report("page_created")

    def _on_layout_draw(self, param):
        # Tab pages (contacts / settings) can be built before the plugin loads and
        # are not always reachable from the fragment stack, so also pick up their
        # root layouts by class name (e.g. "org.telegram.ui.SettingsActivity$3").
        try:
            view = param.thisObject
            view_id = self._ident(view)
            if view_id in self._views or view_id in self._seen:
                return
            if len(self._seen) > 2048:
                self._seen.clear()
            self._seen.add(view_id)
            page = PAGE_BY_CLASS.get(str(view.getClass().getName()).split("$")[0])
            if page is None:
                return
            view = self._register(page, None, view)
            if view is None:
                return
            self._log_info("found %s page" % page)
            if self._page_on(page):
                def attach():
                    self._attach_home(view)
                    self._apply_glass_alpha(page, view, True)
                self._ui(attach, delay=1)
        except Exception:
            self._report("layout_draw")

    def _log_info(self, text):
        try:
            self.log(text)
        except Exception:
            pass

    def _on_page_destroyed(self, param):
        try:
            view_id = self._frags.pop(self._ident(param.thisObject), None)
            if view_id is not None:
                self._views.pop(view_id, None)
        except Exception:
            self._report("page_destroyed")

    def _on_get_new_drawable(self, param):
        try:
            view = param.thisObject
            page = self._page_of(view)
            if page is None or not self._page_on(page):
                return
            drawable = self._page_drawable_for(page, view)
            if drawable is not None:
                param.setResult(drawable)
        except Exception:
            self._report("get_new_drawable")

    def _on_get_new_motion(self, param):
        try:
            page = self._page_of(param.thisObject)
            if page is not None and self._page_on(page):
                param.setResult(False)
        except Exception:
            self._report("get_new_motion")

    def _on_draw_bar(self, param):
        # Home top bar: instead of the opaque theme color (or frosted list capture),
        # paint the same backdrop so the bar shares the list's transparency.
        try:
            if len(param.args) < 5 or not param.args[4]:
                return
            view = param.thisObject
            page = self._page_of(view)
            if page is None or not self._page_on(page):
                return
            self._apply_glass_alpha(page, view, True)
            drawable = self._page_drawable_for(page, view)
            if drawable is None:
                return
            canvas, rect = param.args[0], param.args[2]
            canvas.save()
            canvas.clipRect(rect)
            canvas.translate(0.0, -float(param.args[1]))
            drawable.setBounds(0, 0, view.getMeasuredWidth(), view.getRootView().getMeasuredHeight())
            drawable.draw(canvas)
            canvas.restore()
            param.setResult(None)
        except Exception:
            self._report("draw_bar")

    def _apply_glass_alpha(self, page, view, on, depth=0):
        # Folder tabs / top panels / action bar fades are glass drawables whose
        # source is the solid theme color: fade them to let the backdrop through.
        from android.view import ViewGroup

        alpha = self._page_alpha(page) if on else 255
        for i in range(view.getChildCount()):
            child = view.getChildAt(i)
            if child is None:
                continue
            background = child.getBackground()
            if background is not None and self._is_glass_panel(child, background):
                if background.getAlpha() != alpha:
                    background.setAlpha(alpha)
                    child.invalidate()
            elif depth == 0 and isinstance(child, ViewGroup) and \
                    "RecyclerView" not in str(child.getClass().getName()):
                self._apply_glass_alpha(page, child, on, depth + 1)

    @staticmethod
    def _is_glass_panel(child, background):
        if str(background.getClass().getName()) == "org.telegram.utils.glass.fade.GlassFadeBlurredDrawable":
            return True
        cls = child.getClass()
        for _ in range(2):
            if cls is None:
                break
            if str(cls.getName()) in HOME_GLASS_PANELS:
                return True
            cls = cls.getSuperclass()
        return False

    def _layer_alpha(self, param, page, saves):
        save = None
        try:
            if page is not None and self._page_on(page):
                alpha = self._page_alpha(page)
                if alpha <= 0:
                    param.setResult(None)
                elif alpha < 255:
                    canvas = param.args[0]
                    save = canvas.saveLayerAlpha(0.0, 0.0, float(canvas.getWidth()),
                                                 float(canvas.getHeight()), alpha)
        except Exception:
            self._report("layer_alpha")
        saves.append(save)

    def _restore_layer(self, param, saves):
        try:
            save = saves.pop() if saves else None
            if save is not None:
                param.args[0].restoreToCount(save)
        except Exception:
            self._report("restore_layer")

    def _before_fade(self, param):
        page = None
        try:
            page = self._page_of(param.thisObject.getParent())
        except Exception:
            pass
        self._layer_alpha(param, page, self._fade_saves)

    def _after_fade(self, param):
        self._restore_layer(param, self._fade_saves)

    def _before_cards(self, param):
        # Section cards (contacts / settings) get the page transparency too.
        page = None
        try:
            if self._views and len(param.args) > 1:
                page = self._page_of_parents(param.args[1].getParent())
        except Exception:
            pass
        self._layer_alpha(param, page, self._card_saves)

    def _on_search_field(self, param):
        # The search box on contacts / settings is an opaque white pill.
        try:
            if not self._views:
                return
            field = param.thisObject
            page = self._page_of_parents(field.getParent())
            if page is None or page == "home":
                return
            background = self._search_bg.get(field)
            if background is None:
                return
            alpha = self._page_alpha(page) if self._page_on(page) else 255
            if background.getAlpha() != alpha:
                background.setAlpha(alpha)
        except Exception:
            self._report("search_field")

    def _before_list_cards(self, param):
        page = None
        try:
            if self._views:
                page = self._page_of_parents(param.thisObject.getParent())
        except Exception:
            pass
        self._layer_alpha(param, page, self._card_saves)

    def _after_cards(self, param):
        self._restore_layer(param, self._card_saves)

    @staticmethod
    def _attach_home(view):
        # The placeholder only makes the layout create its background view; the
        # real drawable is supplied through getNewDrawable() on the next frame.
        from android.graphics.drawable import ColorDrawable
        view.setBackgroundImage(ColorDrawable(0), False)
        view.invalidate()

    @staticmethod
    def _detach_home(view):
        try:
            if view.getBackgroundImage() is not None:
                view.setBackgroundImage(None, False)
                view.invalidate()
        except Exception:
            pass

    def _invalidate_tree(self, view, depth=0):
        for i in range(view.getChildCount()):
            child = view.getChildAt(i)
            child.invalidate()
            if depth < 1 and hasattr(child, "getChildCount"):
                self._invalidate_tree(child, depth + 1)

    def _refresh_page(self, page):
        self._gen[page] = self._gen.get(page, 0) + 1
        self._cache.pop(page, None)
        on = self._page_on(page)

        def apply():
            if on and not any(p == page for p, _ in self._views.values()):
                self._scan_pages()
            for view_page, view in list(self._views.values()):
                if view_page != page:
                    continue
                try:
                    if on:
                        self._attach_home(view)
                    else:
                        self._detach_home(view)
                    self._apply_glass_alpha(page, view, on)
                    self._invalidate_tree(view)
                except Exception:
                    self._report("refresh_page")
        self._ui(apply)

    def _page_drawable_for(self, page, view):
        from org.telegram.messenger import AndroidUtilities
        from org.telegram.ui.ActionBar import Theme

        w = view.getMeasuredWidth()
        h = view.getRootView().getMeasuredHeight()
        if w <= 0 or h <= 0:
            w, h = AndroidUtilities.displaySize.x, AndroidUtilities.displaySize.y
        color = Theme.getColor(Theme.key_windowBackgroundWhite if page == "home"
                               else Theme.key_windowBackgroundGray)
        cached = self._cache.get(page)
        source = None
        if self._cfg[page + "_mode"] == HOME_CHAT:
            source = Theme.getCachedWallpaperNonBlocking()
            if source is None:
                return cached[1] if cached else None
        key = (w, h, color, self._gen.get(page, 0), self._ident(source) if source is not None else 0)
        if cached is not None and cached[0] == key:
            return cached[1]
        try:
            drawable = self._build_page(page, view, w, h, color, source)
            self._cache[page] = (key, drawable)
            return drawable
        except Exception:
            self._report("build_page")
            return cached[1] if cached else None

    def _build_page(self, page, view, w, h, color, source):
        from java import jarray
        from android.graphics import Bitmap, Canvas, Paint, RectF
        from android.graphics.drawable import BitmapDrawable, Drawable, LayerDrawable

        bitmap = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
        canvas = Canvas(bitmap)
        canvas.drawColor(_with_alpha(color, 255))

        image = None
        if self._cfg[page + "_mode"] == HOME_IMAGE:
            image = self._load_page_bitmap(page)
        elif source is not None and source.getClass().getName() == "android.graphics.drawable.BitmapDrawable":
            image = source.getBitmap()
        if image is not None:
            bw, bh = image.getWidth(), image.getHeight()
            scale = max(w / float(bw), h / float(bh))
            dw, dh = bw * scale, bh * scale
            left, top = (w - dw) / 2.0, (h - dh) / 2.0
            canvas.drawBitmap(image, None, RectF(left, top, left + dw, top + dh),
                              Paint(Paint.FILTER_BITMAP_FLAG | Paint.ANTI_ALIAS_FLAG))
        elif source is not None:
            old = source.copyBounds()
            source.setBounds(0, 0, w, h)
            try:
                source.draw(canvas)
            finally:
                source.setBounds(old)

        canvas.drawColor(_with_alpha(color, self._page_alpha(page)))
        layer = jarray(Drawable)([BitmapDrawable(view.getResources(), bitmap)])
        # LayerDrawable (not BitmapDrawable) so the layout stretches it over the
        # whole view instead of clipping out the action bar area.
        return LayerDrawable(layer)

    @staticmethod
    def _page_path(page):
        from file_utils import get_plugin_dir
        directory = get_plugin_dir(__id__)
        return os.path.join(directory, page + "_wallpaper.jpg") if directory else None

    def _load_page_bitmap(self, page):
        if page in self._bitmaps:
            return self._bitmaps[page]
        path = self._page_path(page)
        if not path or not os.path.exists(path):
            return None
        from android.graphics import BitmapFactory
        self._bitmaps[page] = BitmapFactory.decodeFile(path)
        return self._bitmaps[page]

    def _pick_image(self, page):
        try:
            from android.content import Intent
            from android_utils import get_activity

            activity = get_activity()
            if activity is None:
                return
            intent = Intent(Intent.ACTION_GET_CONTENT)
            intent.setType("image/*")
            intent.addCategory(Intent.CATEGORY_OPENABLE)
            label, code = PAGE_INFO[page][1], PAGE_INFO[page][3]
            activity.startActivityForResult(Intent.createChooser(intent, "选择%s壁纸" % label), code)
        except Exception:
            self._report("pick_image")
            self._bulletin("打开相册失败", error=True)

    @staticmethod
    def _as_int(value):
        return value.intValue() if hasattr(value, "intValue") else int(value)

    def _on_activity_result(self, param):
        try:
            code = self._as_int(param.args[0])
            page = next((p for p, _, _, c in PAGES if c == code), None)
            if page is None:
                return
            param.setResult(None)
            data = param.args[2]
            if self._as_int(param.args[1]) != -1 or data is None or data.getData() is None:
                return
            threading.Thread(target=self._import_image, args=(page, data.getData()), daemon=True).start()
        except Exception:
            self._report("activity_result")

    def _import_image(self, page, uri):
        try:
            from android.graphics import Bitmap, BitmapFactory
            from java.io import FileOutputStream
            from org.telegram.messenger import ApplicationLoader

            resolver = ApplicationLoader.applicationContext.getContentResolver()
            opts = BitmapFactory.Options()
            opts.inJustDecodeBounds = True
            stream = resolver.openInputStream(uri)
            try:
                BitmapFactory.decodeStream(stream, None, opts)
            finally:
                stream.close()
            sample = 1
            while max(opts.outWidth, opts.outHeight) / (sample * 2) >= HOME_MAX_SIDE:
                sample *= 2
            opts = BitmapFactory.Options()
            opts.inSampleSize = sample
            stream = resolver.openInputStream(uri)
            try:
                image = BitmapFactory.decodeStream(stream, None, opts)
            finally:
                stream.close()
            if image is None:
                raise ValueError("cannot decode image")

            out = FileOutputStream(self._page_path(page))
            try:
                image.compress(Bitmap.CompressFormat.JPEG, 92, out)
            finally:
                out.close()

            def done():
                self.set_setting(page + "_mode", HOME_IMAGE)
                cfg = dict(self._cfg)
                cfg[page + "_mode"] = HOME_IMAGE
                self._apply_cfg(cfg)
                self._bitmaps[page] = image
                self._refresh_page(page)
                self._bulletin("%s壁纸已设置" % PAGE_INFO[page][1])
            self._ui(done)
        except Exception:
            self._report("import_image")
            self._bulletin("读取图片失败", error=True)

    @staticmethod
    def _bulletin(text, error=False):
        try:
            from ui.bulletin import BulletinHelper
            (BulletinHelper.show_error if error else BulletinHelper.show_success)(text)
        except Exception:
            pass

    # ---------- drawing ----------

    def _active(self):
        cfg = self._cfg
        return cfg["enabled"] and (cfg["style"] != STYLE_THEME or cfg["transparency"] > 0 or
                                   (cfg["blur"] > 0 and cfg["density"] > 0))

    # ---------- contact groups ----------

    def _cg_rows(self):
        return [
            Header(text="联系人分组"),
            Switch(key="groups_on_idx", text="启用分组", default="false", icon="msg_folders",
                   subtext="联系人页按分类分段显示，长按联系人可分类或隐藏",
                   on_change=lambda v, k="groups_on": (self._cg_switch(k, bool(v)), self._cg_refresh())),
            Input(key="groups_names", text="分类名称", default=GROUPS_DEFAULT, icon="msg_edit",
                  subtext="用逗号分隔，按此顺序显示",
                  on_change=lambda *_: self._cg_names_changed()),
            Switch(key="groups_show_hidden_idx", text="显示「已隐藏」分组", default="false", icon="msg_archive_hide",
                   subtext="显示后可长按其中的人取消隐藏",
                   on_change=lambda v, k="groups_show_hidden": (self._cg_switch(k, bool(v)), self._cg_refresh())),
            Text(text="展开全部分组", icon="msg_select", on_click=lambda *_: self._cg_expand_all()),
            Divider(text="开启后，联系人页的长按改为「分类 / 隐藏」菜单；关闭即恢复原样。"),
        ]

    def _cg_init(self):
        self._cg_fields = {}
        self._cg_sections = {}
        self._cg_adapter = None
        self._cg_listeners = {}
        self._cg_touch = {}
        self._cg_load()

    def _cg_unload(self):
        adapter = self._cg_adapter
        self._cg_adapter = None
        self._cg_sections = {}
        self._cg_listeners = {}
        if adapter is not None:
            def restore():
                try:
                    adapter.notifySectionsChanged()
                    adapter.notifyDataSetChanged()
                except Exception:
                    pass
            self._ui(restore, delay=500)

    def _cg_load(self):
        import json
        self._cg = {"map": {}, "hidden": [], "collapsed": []}
        try:
            data = self.get_setting("groups_data", "{}") or "{}"
            if isinstance(data, (str, bytes)):
                data = json.loads(data)
            if isinstance(data, dict):
                for key, default in self._cg.items():
                    if isinstance(data.get(key), type(default)):
                        self._cg[key] = data[key]
        except Exception:
            self._report("groups_load")

    def _cg_save(self):
        import json
        self.set_setting("groups_data", json.dumps(self._cg, ensure_ascii=False))
        self._cg_refresh()

    def _cg_names(self):
        raw = self.get_setting("groups_names", GROUPS_DEFAULT) or ""
        names = []
        for part in str(raw).replace("，", ",").replace("、", ",").split(","):
            part = part.strip()
            if part and part not in names and part not in (UNGROUPED, HIDDEN_GROUP):
                names.append(part)
        return names

    @staticmethod
    def _jval(value):
        text = str(value)
        if text.lower() in ("true", "false"):
            return text.lower() == "true"
        try:
            return int(text)
        except ValueError:
            return value

    def _cg_raw(self, adapter, name):
        field = self._cg_fields.get(name)
        if field is None:
            field = _java_class(CG_ADAPTER).getDeclaredField(name)
            field.setAccessible(True)
            self._cg_fields[name] = field
        return field.get(adapter)

    def _cg_field(self, adapter, name):
        return self._jval(self._cg_raw(adapter, name))

    def _cg_bool(self, key):
        # SDK switches hand back their key with "_idx"; older saves used the plain key.
        # A stored Java Boolean makes get_setting() fail, so fall back to raw prefs.
        for k in (key + "_idx", key):
            value = self.get_setting(k, None)
            if value is not None:
                return self._cg_on(value)
        try:
            from org.telegram.messenger import ApplicationLoader
            prefs = ApplicationLoader.applicationContext.getSharedPreferences(
                "plugin_settings_" + str(__id__), 0)
            all_prefs = prefs.getAll()
            for k in (key + "_idx", key):
                if all_prefs.containsKey(k):
                    return self._cg_on(all_prefs.get(k))
        except Exception:
            pass
        return False

    def _cg_on(self, value):
        # A stored Java Boolean makes get_setting() fail and return the default,
        # so also accept plain booleans / numbers here.
        import json
        try:
            value = json.loads(value) if isinstance(value, (str, bytes)) else value
        except ValueError:
            pass
        if isinstance(value, bool):
            return value
        return str(value).lower() in ("true", "1")

    def _cg_switch(self, key, on):
        # Store booleans as JSON strings: PythonBridge.getSetting casts to String.
        for k in (key, key + "_idx"):
            self.set_setting(k, "true" if on else "false")

    def _cg_active(self, adapter):
        if not self._cg_bool("groups_on"):
            return False
        return (self._cg_field(adapter, "onlyUsers") == 0 and not self._cg_field(adapter, "isAdmin")
                and not self._cg_field(adapter, "isEmptyWithMainTabs"))

    def _cg_build(self, adapter):
        from org.telegram.messenger import ContactsController, MessagesController, UserConfig

        account = UserConfig.selectedAccount
        source = None
        if self._cg_field(adapter, "sortType") == 2:
            source = self._cg_raw(adapter, "onlineContacts")
        if source is None:
            source = ContactsController.getInstance(account).contacts
        messages = MessagesController.getInstance(account)
        names = self._cg_names()
        buckets = {name: [] for name in names + [UNGROUPED, HIDDEN_GROUP]}
        mapping, hidden = self._cg["map"], set(self._cg["hidden"])
        for i in range(source.size()):
            uid = int(source.get(i).user_id)
            user = messages.getUser(uid)
            if user is None:
                continue
            if uid in hidden:
                buckets[HIDDEN_GROUP].append(user)
            else:
                buckets.get(mapping.get(str(uid), UNGROUPED), buckets[UNGROUPED]).append(user)
        order = names + [UNGROUPED]
        if self._cg_bool("groups_show_hidden"):
            order.append(HIDDEN_GROUP)
        collapsed = set(self._cg["collapsed"])
        return [(name, buckets[name], name in collapsed) for name in order
                if buckets[name] or name in names]

    def _hook_contacts(self):
        for method, fn in (("getSectionCount", self._cg_section_count), ("getCountForSection", self._cg_count),
                           ("getItemViewType", self._cg_view_type), ("getItem", self._cg_item),
                           ("isEnabled", self._cg_enabled_row), ("getSectionHeaderView", self._cg_header_view),
                           ("getLetter", self._cg_letter)):
            self._try_hook(CG_ADAPTER, method, _Hook(after=fn), quiet=True)
        self._try_hook(CG_ADAPTER, "onBindViewHolder", _Hook(before=self._cg_bind), quiet=True)
        self._try_hook("org.telegram.ui.ContactsActivity", "showOrUpdateActionMode",
                       _Hook(before=self._cg_long_press), quiet=True)
        # RecyclerListView runs its own gesture detector that swallows long-presses
        # before the header cell's view listener can fire, so track them here.
        self._try_hook("org.telegram.ui.Components.RecyclerListView", "dispatchTouchEvent",
                       _Hook(before=self._cg_touch_event), quiet=True)

    def _cg_section_count(self, param):
        try:
            adapter = param.thisObject
            if not self._cg_active(adapter):
                self._cg_sections.pop(self._ident(adapter), None)
                return
            sections = self._cg_build(adapter)
            self._cg_sections = {self._ident(adapter): sections}
            self._cg_adapter = adapter
            param.setResult(1 + len(sections))
        except Exception:
            self._report("groups_sections")

    def _cg_of(self, param, section):
        sections = self._cg_sections.get(self._ident(param.thisObject))
        if not sections or section < 1 or section > len(sections):
            return None
        return sections[section - 1]

    def _cg_count(self, param):
        try:
            entry = self._cg_of(param, int(param.args[0]))
            if entry is not None:
                param.setResult(1 if entry[2] else 1 + len(entry[1]))
        except Exception:
            self._report("groups_rows")

    def _cg_view_type(self, param):
        try:
            if len(param.args) != 2:
                return
            entry = self._cg_of(param, int(param.args[0]))
            if entry is not None:
                param.setResult(CG_GRAY_CELL if int(param.args[1]) == 0 else CG_USER_CELL)
        except Exception:
            self._report("groups_view_type")

    def _cg_item(self, param):
        try:
            if len(param.args) != 2:
                return
            entry = self._cg_of(param, int(param.args[0]))
            if entry is None:
                return
            pos = int(param.args[1])
            if pos == 0:
                param.setResult("Header")
            else:
                param.setResult(entry[1][pos - 1] if pos - 1 < len(entry[1]) else None)
        except Exception:
            self._report("groups_item")

    def _cg_enabled_row(self, param):
        try:
            if len(param.args) != 3:
                return
            entry = self._cg_of(param, int(param.args[1]))
            if entry is not None:
                param.setResult(int(param.args[2]) > 0)
        except Exception:
            self._report("groups_enabled")

    def _cg_header_view(self, param):
        try:
            entry = self._cg_of(param, int(param.args[0]))
            view = param.getResult()
            if entry is not None and view is not None:
                from java import cast
                from org.telegram.ui.Cells import LetterSectionCell
                cast(LetterSectionCell, view).setLetter("")
        except Exception:
            self._report("groups_header")

    def _cg_letter(self, param):
        try:
            if self._cg_sections.get(self._ident(param.thisObject)):
                param.setResult(None)
        except Exception:
            self._report("groups_letter")

    def _cg_bind(self, param):
        try:
            if len(param.args) != 3:
                return
            section, pos, holder = int(param.args[0]), int(param.args[1]), param.args[2]
            entry = self._cg_of(param, section)
            if entry is None:
                return
            from java import cast
            name, users, collapsed = entry
            if pos == 0:
                from android_utils import OnClickListener
                from org.telegram.ui.Cells import GraySectionCell
                cell = cast(GraySectionCell, holder.itemView)
                # GraySectionCell is excluded from the section cards and has its own
                # opaque gray background: drop it so the page wallpaper shows through.
                try:
                    cell.setNoBackground(True)
                except Exception:
                    pass
                # 32dp headers are easy to mis-tap into the neighbour group.
                try:
                    cell.setLayerHeight(44)
                except Exception:
                    pass
                listener = self._cg_listeners.get(name)
                if listener is None:
                    listener = OnClickListener(lambda v, n=name: self._cg_toggle(n))
                    self._cg_listeners[name] = listener
                cell.setText("%s · %d" % (name, len(users)), "展开" if collapsed else "收起", listener)
                cell.setOnClickListener(listener)
                # The full-width textView inside the cell is clickable and consumes
                # touches before they reach the cell, so listen there too.
                try:
                    text_view = cell.getTextView()
                    if text_view is not None:
                        text_view.setOnClickListener(listener)
                except Exception:
                    pass
            elif pos - 1 < len(users):
                from org.telegram.ui.Cells import UserCell
                cell = cast(UserCell, holder.itemView)
                cell.setAvatarPadding(7, 1)
                cell.setData(users[pos - 1], None, None, 0)
                cell.setChecked(False, False)
            param.setResult(None)
        except Exception:
            self._report("groups_bind")

    def _cg_names_changed(self):
        try:
            self._exteraless_drop_settings_cache()
        except Exception:
            pass
        self._cg_refresh()

    def _cg_touch_event(self, param):
        # Watch touches on the contacts list: a stationary press on a group header
        # for ~0.6s opens the header menu (the list's own long-press ignores headers).
        try:
            if len(param.args) != 1:
                return
            from java.lang import System

            view = param.thisObject
            event = param.args[0]
            action = int(event.getActionMasked())
            ident = System.identityHashCode(view)
            state = self._cg_touch.get(ident)
            if action == 0:
                adapter = view.getAdapter()
                sections = self._cg_sections.get(self._ident(adapter)) if adapter is not None else None
                if not sections:
                    self._cg_touch.pop(ident, None)
                    return
                x, y = float(event.getX()), float(event.getY())
                self._cg_touch[ident] = [0, x, y]
                generation = 0
                from android_utils import run_on_ui_thread

                def fire(v=view, i=ident, g=generation, fx=x, fy=y):
                    cur = self._cg_touch.get(i)
                    if cur is not None and cur[0] == g:
                        self._cg_touch.pop(i, None)
                        self._cg_header_long_press(v, fx, fy)

                run_on_ui_thread(fire, 600)
            elif state is not None:
                if action == 2:
                    if abs(float(event.getX()) - state[1]) > 48 or abs(float(event.getY()) - state[2]) > 48:
                        state[0] += 1
                elif action in (1, 3):
                    state[0] += 1
        except Exception:
            self._report("groups_touch")

    def _cg_header_long_press(self, view, x, y):
        try:
            child = view.findChildViewUnder(x, y)
            cell = child
            while cell is not None and "GraySectionCell" not in str(cell.getClass().getName()):
                parent = cell.getParent()
                if parent is None or parent is view:
                    cell = None
                    break
                cell = parent
            if cell is None:
                return
            adapter = view.getAdapter()
            if adapter is None:
                return
            flat = int(view.getChildAdapterPosition(cell))
            if flat < 0:
                return
            section = int(adapter.getSectionForPosition(flat))
            if section < 1 or int(adapter.getPositionInSectionForPosition(flat)) != 0:
                return
            sections = self._cg_sections.get(self._ident(adapter))
            entry = sections[section - 1] if sections and 0 <= section - 1 < len(sections) else None
            if entry is not None:
                self._cg_header_menu(entry[0], view.getContext())
        except Exception:
            self._report("groups_header_long")

    def _cg_header_menu(self, name, context=None):
        # Long-press on a category header: collapse/expand or move it up/down.
        try:
            from ui.alert import AlertDialogBuilder
            from android_utils import get_activity

            names = self._cg_names()
            collapsed = name in self._cg["collapsed"]
            items = ["展开" if collapsed else "收起"]
            index = names.index(name) if name in names else -1
            if index > 0:
                items.append("上移")
            if 0 <= index < len(names) - 1:
                items.append("下移")

            def on_pick(builder, which):
                action = items[int(which)]
                if action in ("收起", "展开"):
                    self._cg_toggle(name)
                elif action == "上移":
                    self._cg_move(name, -1)
                else:
                    self._cg_move(name, 1)

            AlertDialogBuilder(context if context is not None else get_activity()).set_title(name) \
                .set_items(items, on_pick).set_negative_button("取消").show()
        except Exception:
            self._report("groups_header_menu")
        return True

    def _cg_move(self, name, delta):
        names = self._cg_names()
        try:
            index = names.index(name)
        except ValueError:
            return
        other = index + delta
        if not 0 <= other < len(names):
            return
        names[index], names[other] = names[other], names[index]
        self.set_setting("groups_names", ",".join(names), reload_settings=True)
        self._cg_refresh()

    def _cg_toggle(self, name):
        collapsed = self._cg["collapsed"]
        if name in collapsed:
            collapsed.remove(name)
        else:
            collapsed.append(name)
        self._cg_save()

    def _cg_expand_all(self):
        self._cg["collapsed"] = []
        self._cg_save()

    def _cg_refresh(self):
        adapter = self._cg_adapter
        if adapter is None:
            return

        def run():
            try:
                adapter.notifySectionsChanged()
                adapter.notifyDataSetChanged()
            except Exception:
                self._report("groups_refresh")
        self._ui(run)

    def _cg_long_press(self, param):
        try:
            cell = param.args[0]
            if cell is None or "UserCell" not in str(cell.getClass().getName()):
                return
            adapter = self._cg_adapter
            if adapter is None or not self._cg_sections or not self._cg_active(adapter):
                return
            from java import cast
            from org.telegram.ui.Cells import UserCell
            uid = int(cast(UserCell, cell).getDialogId())
            if uid <= 0:
                return
            param.setResult(None)
            self._cg_dialog(param.thisObject, uid)
        except Exception:
            self._report("groups_long_press")

    def _cg_dialog(self, fragment, uid):
        from ui.alert import AlertDialogBuilder
        from org.telegram.messenger import MessagesController, UserConfig, UserObject

        user = MessagesController.getInstance(UserConfig.selectedAccount).getUser(uid)
        title = str(UserObject.getUserName(user)) if user is not None else str(uid)
        names = self._cg_names()
        current = self._cg["map"].get(str(uid))
        hidden = uid in self._cg["hidden"]
        items = [("✓ " if n == current else "") + n for n in names]
        items += ["新建分类…", "取消隐藏" if hidden else "隐藏此人"]
        if current:
            items.append("移出「%s」" % current)

        def on_pick(builder, which):
            which = int(which)
            if which < len(names):
                self._cg_assign(uid, names[which])
            elif which == len(names):
                self._cg_new_group(fragment, uid)
            elif which == len(names) + 1:
                self._cg_hide(uid, not hidden)
            else:
                self._cg_assign(uid, None)

        AlertDialogBuilder(fragment.getParentActivity()).set_title(title) \
            .set_items(items, on_pick).set_negative_button("取消").show()

    def _cg_assign(self, uid, name):
        key = str(uid)
        if name is None:
            self._cg["map"].pop(key, None)
        else:
            self._cg["map"][key] = name
        if uid in self._cg["hidden"]:
            self._cg["hidden"].remove(uid)
        self._cg_save()

    def _cg_hide(self, uid, hide):
        hidden = self._cg["hidden"]
        if hide and uid not in hidden:
            hidden.append(uid)
        elif not hide and uid in hidden:
            hidden.remove(uid)
        self._cg_save()

    def _cg_new_group(self, fragment, uid):
        from ui.alert import AlertDialogBuilder
        from android.widget import EditText

        context = fragment.getParentActivity()
        edit = EditText(context)
        try:
            from org.telegram.messenger import AndroidUtilities
            from org.telegram.ui.ActionBar import Theme
            edit.setHint("分类名称")
            edit.setSingleLine(True)
            edit.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            edit.setHintTextColor(Theme.getColor(Theme.key_dialogTextHint))
            pad = int(AndroidUtilities.dp(20))
            edit.setPadding(pad, pad // 2, pad, pad // 2)
        except Exception:
            pass

        def ok(builder, which):
            name = str(edit.getText().toString()).strip().replace(",", " ").replace("，", " ")
            if not name or name in (UNGROUPED, HIDDEN_GROUP):
                return
            names = self._cg_names()
            if name not in names:
                names.append(name)
                self.set_setting("groups_names", ",".join(names), reload_settings=True)
            self._cg_assign(uid, name)

        AlertDialogBuilder(context).set_title("新建分类").set_view(edit) \
            .set_positive_button("确定", ok).set_negative_button("取消").show()

    def _report(self, tag):
        if tag not in self._reported:
            self._reported.add(tag)
            self._log_error("bubble_glass error in %s" % tag)

    def _log_error(self, msg):
        # Older exteraless SDKs have no `logger`, so stick to log() / stderr.
        import traceback
        text = "%s\n%s" % (msg, traceback.format_exc())
        try:
            self.log(text)
        except Exception:
            print("[bubble_glass] " + text)

    def _style(self):
        style = self._cfg["style"]
        if style == STYLE_AUTO:
            from org.telegram.ui.ActionBar import Theme
            return STYLE_NIGHT if Theme.isCurrentThemeDark() else STYLE_CLEAR
        return style

    @staticmethod
    def _should_handle(param):
        if param.args[1] is not None:
            return None
        canvas = param.args[0]
        if canvas is None or not canvas.isHardwareAccelerated():
            return None
        return canvas

    def _before_draw(self, param):
        try:
            if not self._active():
                return
            canvas = self._should_handle(param)
            if canvas is None:
                return
            cfg = self._cfg
            d = param.thisObject
            base_alpha = d.paint.getAlpha() / 255.0
            if base_alpha <= 0:
                return
            style = self._style()

            if cfg["blur"] > 0 and cfg["density"] > 0:
                shader = self._backdrop()
                if shader is not None:
                    self._matrix.set(self._bd_base)
                    off_x, off_y = self._list_off
                    self._matrix.postTranslate(float(-off_x), float(-(d.getTopY() + off_y)))
                    shader.setLocalMatrix(self._matrix)
                    self._frost_paint.setShader(shader)
                    self._frost_paint.setAlpha(int(255 * base_alpha * cfg["density"] / 100.0))
                    d.draw(canvas, self._frost_paint)

            opacity = (100.0 - cfg["transparency"]) / 100.0
            if style == STYLE_THEME:
                if opacity >= 1.0:
                    self._layers.append(-1)
                elif opacity <= 0.0:
                    self._draw_outline(d, canvas, THEME_OUTLINE, base_alpha)
                    param.setResult(None)
                else:
                    b = d.getBounds()
                    self._layers.append(canvas.saveLayerAlpha(
                        float(b.left), float(b.top), float(b.right), float(b.bottom), int(255 * opacity)))
                return

            tint_in, tint_out, outline = TINTS[style]
            if opacity > 0:
                tint = tint_out if self._is_out_field.getBoolean(d) else tint_in
                self._tint_paint.setColor(_with_alpha(tint, 255 * base_alpha * opacity))
                d.draw(canvas, self._tint_paint)
            self._draw_outline(d, canvas, outline, base_alpha)
            param.setResult(None)
        except Exception:
            self._report("before_draw")

    def _after_draw(self, param):
        try:
            if not self._layers or self._should_handle(param) is None:
                return
            save_count = self._layers.pop()
            canvas = param.args[0]
            if save_count >= 0:
                canvas.restoreToCount(save_count)
            self._draw_outline(param.thisObject, canvas, THEME_OUTLINE, param.thisObject.paint.getAlpha() / 255.0)
        except Exception:
            self._layers = []
            self._report("after_draw")

    def _draw_outline(self, d, canvas, color, base_alpha):
        if not self._cfg["outline"]:
            return
        from org.telegram.messenger import AndroidUtilities
        self._stroke_paint.setStrokeWidth(max(1.0, AndroidUtilities.dp(0.66)))
        self._stroke_paint.setColor(_with_alpha(color, ((color >> 24) & 0xFF) * base_alpha))
        d.draw(canvas, self._stroke_paint)

    # ---------- keep frosted layer pinned to the wallpaper while scrolling ----------

    def _on_visible(self, param):
        # RecyclerView scrolls by moving cached display lists, so a cell's bubble
        # isn't redrawn and the baked-in blur would slide along with it.
        try:
            if not self._active() or self._cfg["blur"] <= 0 or self._cfg["density"] <= 0:
                return
            from java import jarray, jint
            from java.lang import System

            cell = param.thisObject
            parent = cell.getParent()
            if parent is not None:
                loc = jarray(jint)(2)
                parent.getLocationInWindow(loc)
                px, py = loc[0], loc[1]
                bx = by = 0
                view = self._bg_view
                if view is not None and view.isAttachedToWindow():
                    view.getLocationInWindow(loc)
                    bx, by = loc[0], loc[1]
                self._list_off = (px - bx, py - by)
            state = (cell.getTop(), self._list_off, self._bd_gen)
            key = System.identityHashCode(cell)
            if self._cell_state.get(key) != state:
                if len(self._cell_state) > 256:
                    self._cell_state.clear()
                self._cell_state[key] = state
                cell.invalidate()
        except Exception:
            self._report("on_visible")

    # ---------- blurred wallpaper ----------

    def _current_background(self):
        from org.telegram.messenger import AndroidUtilities
        from org.telegram.ui import LaunchActivity
        from org.telegram.ui.ActionBar import Theme

        try:
            fragment = LaunchActivity.getLastFragment()
            get_content_view = getattr(fragment, "getContentView", None) if fragment is not None else None
            view = get_content_view() if get_content_view is not None else None
            if view is not None and view.getMeasuredWidth() > 0:
                drawable = view.getBackgroundImage()
                if drawable is not None:
                    self._bg_view = view
                    return drawable, view.getMeasuredWidth(), view.getRootView().getMeasuredHeight()
        except Exception:
            self._report("current_background")
        drawable = Theme.getCachedWallpaperNonBlocking()
        if drawable is None:
            return None
        self._bg_view = None
        return drawable, AndroidUtilities.displaySize.x, AndroidUtilities.displaySize.y

    def _backdrop(self):
        now = time.monotonic()
        if self._bd_shader is not None and now - self._bd_checked < BACKDROP_CHECK_INTERVAL:
            return self._bd_shader
        self._bd_checked = now

        from java.lang import System
        bg = self._current_background()
        if bg is None:
            return self._bd_shader
        drawable, width, height = bg
        b = drawable.getBounds()
        key = (System.identityHashCode(drawable), b.left, b.top, b.right, b.bottom,
               width, height, self._cfg["blur"])
        if key == self._bd_key:
            return self._bd_shader
        if self._bd_shader is not None and now - self._bd_built < BACKDROP_MIN_REBUILD_INTERVAL:
            return self._bd_shader
        try:
            self._build_backdrop(drawable, max(1, width), max(1, height))
            self._bd_key = key
            self._bd_built = now
            self._bd_gen += 1
        except Exception:
            self._report("build_backdrop")
        return self._bd_shader

    def _build_backdrop(self, drawable, width, height):
        from android.graphics import Bitmap, BitmapShader, Canvas, Matrix, Shader
        from org.telegram.messenger import Utilities

        bw = max(1, int(width * BACKDROP_SCALE))
        bh = max(1, int(height * BACKDROP_SCALE))
        bitmap = Bitmap.createBitmap(bw, bh, Bitmap.Config.ARGB_8888)
        canvas = Canvas(bitmap)
        canvas.scale(bw / float(width), bh / float(height))

        old_bounds = drawable.copyBounds()
        if old_bounds.isEmpty():
            drawable.setBounds(0, 0, width, height)
        try:
            drawable.draw(canvas)
        finally:
            if old_bounds.isEmpty():
                drawable.setBounds(old_bounds)

        try:
            Utilities.stackBlurBitmap(bitmap, int(self._cfg["blur"]))
        except Exception:
            self._report("stack_blur")

        base = Matrix()
        base.setScale(width / float(bw), height / float(bh))
        self._bd_shader = BitmapShader(bitmap, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP)
        self._bd_base = base

    # ---------- music player (full-screen page) ----------

    def _music_init(self):
        self._music_state = {"dialog": None, "view": None, "handler": None,
                             "runnable": None, "chats": {}, "current": None,
                             "current_id": None, "entries": set(),
                             "lyrics": [], "lyric_idx": -1}

    def _music_unload(self):
        self._music_close_player()
        self._music_state = None

    def _hook_music(self):
        self._try_hook("org.telegram.ui.ChatActivity", "createView",
                       _Hook(after=self._on_chat_created), quiet=True)
        self._try_hook("org.telegram.ui.ChatActivity", "onFragmentDestroy",
                       _Hook(before=self._on_chat_destroyed), quiet=True)
        self._try_hook("org.telegram.ui.DialogsActivity", "createView",
                       _Hook(after=self._on_dialogs_created), quiet=True)
        self._try_hook("org.telegram.ui.DialogsActivity", "onResume",
                       _Hook(after=self._on_dialogs_created), quiet=True)

    def _music_rows(self):
        return [
            Header(text="音乐播放器"),
            Switch(key="music_player", text="播放器入口", default=DEFAULTS["music_player"],
                   icon="msg_music",
                   subtext="在主页右上角三点菜单左边加「音乐」按钮，点开全屏播放页（音频/语音 + 自动歌词）",
                   on_change=lambda v: self._on_music_change(v)),
            Text(text="打开全屏播放器", icon="msg_music", on_click=lambda *_: self._ui(self._player_open)),
            Divider(text="播放当前聊天里的音频/语音消息。"),
        ]

    def _music_on(self):
        return bool(self._cfg.get("music_player"))

    def _on_music_change(self, value):
        self._on_change("music_player", value)

    # ---- chat tracking (playlist source) ----

    def _on_chat_created(self, param):
        try:
            activity = param.thisObject
            view = param.getResult()
            if activity is None or view is None:
                return
            ident = self._ident(activity)
            st = self._music_state
            st["chats"][ident] = {"activity": activity}
            st["current"] = activity
            st["current_id"] = ident
        except Exception:
            self._report("music_created")

    def _on_chat_destroyed(self, param):
        try:
            activity = param.thisObject
            ident = self._ident(activity)
            st = self._music_state
            st["chats"].pop(ident, None)
            if st.get("current_id") == ident:
                st["current"] = None
                st["current_id"] = None
        except Exception:
            self._report("music_destroyed")

    def _music_active_chat(self):
        st = self._music_state
        if st.get("current") is not None:
            return st["current"]
        for c in st["chats"].values():
            return c["activity"]
        return None

    # ---- homepage entry ----

    def _on_dialogs_created(self, param):
        try:
            activity = param.thisObject
            if activity is None or not self._music_on():
                return
            ident = self._ident(activity)
            st = self._music_state
            if ident in st["entries"]:
                return
            ab = getattr(activity, "actionBar", None)
            if ab is None:
                return
            ctx = None
            for getter in ("getParentActivity", "getContext", "getActivity"):
                try:
                    ctx = getattr(activity, getter)()
                    if ctx is not None:
                        break
                except Exception:
                    pass
            if ctx is None:
                return
            from android_utils import OnClickListener
            menu = ab.createMenu()
            index = self._music_menu_index(menu)
            item = menu.addItemAt(index, 0x4D555349, 0, "音乐", 0, None, 0, None, None)
            item.setContentDescription("音乐播放器")
            item.setOnClickListener(OnClickListener(lambda v: self._ui(self._player_open)))
            st["entries"].add(ident)
            self._log_info("music entry added idx=%s" % index)
        except Exception as e:
            self._log_error("music_entry: %s" % e)

    def _music_menu_index(self, menu):
        try:
            count = menu.getChildCount()
            for i in range(count):
                child = menu.getChildAt(i)
                try:
                    tag = child.getTag()
                    if tag is not None and int(tag) == 4:
                        return i
                except Exception:
                    pass
            return max(0, count - 1)
        except Exception:
            return 0

    # ---- full-screen player ----

    def _player_open(self):
        try:
            self._log_info("player_open start state=%s" % (self._music_state is not None))
            if self._music_state.get("dialog") is not None:
                self._log_info("player_open: already open")
                return
            from android.app import Dialog
            from android.view import Window
            from android.view import WindowManager
            ctx = None
            chat = self._music_active_chat()
            if chat is not None:
                for getter in ("getParentActivity", "getContext", "getActivity"):
                    try:
                        ctx = getattr(chat, getter)()
                        if ctx is not None:
                            break
                    except Exception:
                        pass
            if ctx is None:
                from org.telegram.ui import LaunchActivity
                ctx = LaunchActivity.instance
            if ctx is None:
                self._log_error("player_open: no context")
                return
            self._log_info("player_open ctx=%s" % type(ctx).__name__)
            dialog = Dialog(ctx)
            try:
                dialog.requestWindowFeature(Window.FEATURE_NO_TITLE)
            except Exception:
                pass
            view = self._player_make_view(dialog, ctx)
            self._log_info("player_open view=%s" % (view is not None))
            dialog.setContentView(view)
            window = dialog.getWindow()
            if window is not None:
                window.setLayout(WindowManager.LayoutParams.MATCH_PARENT,
                                 WindowManager.LayoutParams.MATCH_PARENT)
                window.setFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN,
                                WindowManager.LayoutParams.FLAG_FULLSCREEN)
            dialog.setCancelable(True)
            from android_utils import _listener as _dlg_listener
            dialog.setOnDismissListener(_dlg_listener("android.content.DialogInterface$OnDismissListener", "onDismiss", lambda d: self._player_on_dismiss(), None))
            dialog.show()
            self._music_state["dialog"] = dialog
            self._music_state["view"] = view
            self._player_load_playing()
            self._player_start_loop()
            self._log_info("player opened")
        except Exception as e:
            try:
                import traceback
                self._log_error("player_open: %s\n%s" % (e, traceback.format_exc()))
            except Exception:
                self._log_error("player_open: %s" % e)

    def _player_on_dismiss(self):
        st = self._music_state
        st["dialog"] = None
        st["view"] = None
        h = st.get("handler")
        r = st.get("runnable")
        if h is not None and r is not None:
            h.removeCallbacks(r)

    def _player_close_player(self):
        try:
            dialog = self._music_state.get("dialog")
            if dialog is not None:
                dialog.dismiss()
        except Exception:
            pass
        self._player_on_dismiss()

    def _player_make_view(self, dialog, ctx):
        from android.graphics import Color, PorterDuff, Typeface
        from android.graphics.drawable import GradientDrawable
        from android.os import Handler, Looper
        from android.text import TextUtils
        from android.view import Gravity, View
        from android.view.animation import Animation, LinearInterpolator, RotateAnimation
        from android.widget import Button, FrameLayout, LinearLayout, ScrollView, SeekBar, TextView
        from org.telegram.ui import AndroidUtilities
        from android_utils import OnClickListener, OnSeekBarChangeListener

        st = self._music_state
        st["dialog"] = dialog
        st["ctx"] = ctx
        st.setdefault("repeat", 1)

        def dp(v):
            return AndroidUtilities.dp(v)

        root = LinearLayout(ctx)
        root.setOrientation(LinearLayout.VERTICAL)
        bg = GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,
                              [0xFFFFD6E8, 0xFFE6D9FF, 0xFFD9E8FF])
        root.setBackground(bg)
        root.setPadding(dp(20), dp(14), dp(20), dp(14))

        # ---- top bar ----
        top = LinearLayout(ctx)
        top.setOrientation(LinearLayout.HORIZONTAL)
        top.setGravity(Gravity.CENTER_VERTICAL)
        top.setLayoutParams(LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT,
            LinearLayout.LayoutParams.WRAP_CONTENT))
        back = TextView(ctx)
        back.setText("收起")
        back.setTextSize(15)
        back.setTextColor(0xFF7A6B8C)
        back.setPadding(dp(6), dp(6), dp(6), dp(6))
        back.setOnClickListener(OnClickListener(lambda v: self._ui(self._player_close_player)))
        top.addView(back)
        title_tv = TextView(ctx)
        title_tv.setText("正在播放")
        title_tv.setTextSize(17)
        title_tv.setTextColor(0xFF4A3B5C)
        title_tv.setTypeface(Typeface.DEFAULT_BOLD)
        tlp = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1.0)
        tlp.gravity = Gravity.CENTER
        title_tv.setLayoutParams(tlp)
        top.addView(title_tv)
        pad = TextView(ctx)
        pad.setText(" ")
        pad.setTextSize(15)
        pad.setPadding(dp(6), dp(6), dp(6), dp(6))
        top.addView(pad)
        root.addView(top)

        # ---- cover / spinning disc ----
        cover_wrap = FrameLayout(ctx)
        cwl = LinearLayout.LayoutParams(LinearLayout.LayoutParams.WRAP_CONTENT,
                                        LinearLayout.LayoutParams.WRAP_CONTENT)
        cwl.gravity = Gravity.CENTER_HORIZONTAL
        cwl.setMargins(0, dp(18), 0, dp(6))
        cover_wrap.setLayoutParams(cwl)

        glow = GradientDrawable()
        glow.setShape(GradientDrawable.OVAL)
        glow.setColor(0x55FF9EC7)
        glow_view = TextView(ctx)
        glow_view.setBackground(glow)
        fl = FrameLayout.LayoutParams(dp(230), dp(230), Gravity.CENTER)
        cover_wrap.addView(glow_view, fl)

        disc_bg = GradientDrawable()
        disc_bg.setShape(GradientDrawable.OVAL)
        disc_bg.setColor(0xFFFFF6FA)
        disc_bg.setStroke(dp(2), 0xFFFFB7D5)
        disc = TextView(ctx)
        disc.setText("💿")
        disc.setTextSize(120)
        disc.setGravity(Gravity.CENTER)
        disc.setBackground(disc_bg)
        st["disc"] = disc
        dl = FrameLayout.LayoutParams(dp(180), dp(180), Gravity.CENTER)
        cover_wrap.addView(disc, dl)

        anim = RotateAnimation(0, 360, Animation.RELATIVE_TO_SELF, 0.5,
                               Animation.RELATIVE_TO_SELF, 0.5)
        anim.setDuration(4000)
        anim.setRepeatCount(Animation.INFINITE)
        anim.setInterpolator(LinearInterpolator())
        st["spin"] = anim
        st["spinning"] = False
        root.addView(cover_wrap)

        # ---- song info ----
        song = TextView(ctx)
        song.setText("未在播放")
        song.setTextSize(20)
        song.setTextColor(0xFF4A3B5C)
        song.setTypeface(Typeface.DEFAULT_BOLD)
        song.setGravity(Gravity.CENTER)
        song.setSingleLine(True)
        song.setEllipsize(TextUtils.TruncateAt.END)
        sl = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT,
                                       LinearLayout.LayoutParams.WRAP_CONTENT)
        sl.setMargins(0, dp(10), 0, 0)
        song.setLayoutParams(sl)
        root.addView(song)
        st["song"] = song

        artist = TextView(ctx)
        artist.setText("")
        artist.setTextSize(14)
        artist.setTextColor(0xFF8A7B9C)
        artist.setGravity(Gravity.CENTER)
        artist.setSingleLine(True)
        artist.setEllipsize(TextUtils.TruncateAt.END)
        al = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT,
                                       LinearLayout.LayoutParams.WRAP_CONTENT)
        al.setMargins(0, dp(2), 0, dp(8))
        artist.setLayoutParams(al)
        root.addView(artist)
        st["artist"] = artist

        # ---- seek bar with avatar thumb ----
        seek = SeekBar(ctx)
        seek.setMax(1000)
        try:
            thumb = self._make_avatar_thumb(ctx)
            if thumb is not None:
                seek.setThumb(thumb)
                seek.setThumbOffset(dp(18))
        except Exception:
            pass
        try:
            seek.getProgressDrawable().setColorFilter(0xFFFF6FA5, PorterDuff.Mode.SRC_IN)
        except Exception:
            pass
        seek.setOnSeekBarChangeListener(OnSeekBarChangeListener(
            lambda sb, prog, from_user: self._player_on_seek_change(prog, from_user),
            lambda sb: None,
            lambda sb: self._player_on_seek_stop(sb.getProgress())))
        st["seek"] = seek
        root.addView(seek)

        times = TextView(ctx)
        times.setText("0:00 / 0:00")
        times.setTextSize(12)
        times.setTextColor(0xFF8A7B9C)
        ttl = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT,
                                        LinearLayout.LayoutParams.WRAP_CONTENT)
        ttl.setMargins(0, dp(2), 0, dp(6))
        times.setLayoutParams(ttl)
        root.addView(times)
        st["times"] = times

        # ---- controls ----
        ctrl = LinearLayout(ctx)
        ctrl.setOrientation(LinearLayout.HORIZONTAL)
        ctrl.setGravity(Gravity.CENTER)
        cl = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT,
                                       LinearLayout.LayoutParams.WRAP_CONTENT)
        cl.setMargins(0, dp(4), 0, dp(4))
        ctrl.setLayoutParams(cl)

        def cbtn(text, fn, size=20):
            b = Button(ctx)
            b.setText(text)
            b.setTextSize(size)
            b.setMinWidth(0)
            b.setMinimumWidth(0)
            b.setPadding(dp(10), 0, dp(10), 0)
            b.setOnClickListener(OnClickListener(lambda v, f=fn: self._ui(f)))
            return b

        st["btn_shuffle"] = cbtn("🔀", self._player_toggle_shuffle, 18)
        ctrl.addView(st["btn_shuffle"])
        ctrl.addView(cbtn("⏮", lambda: self._player_step(-1)))

        play_bg = GradientDrawable()
        play_bg.setShape(GradientDrawable.OVAL)
        play_bg.setColor(0xFFFF6FA5)
        play = TextView(ctx)
        play.setText("▶")
        play.setTextSize(30)
        play.setTextColor(0xFFFFFFFF)
        play.setGravity(Gravity.CENTER)
        play.setBackground(play_bg)
        pll = LinearLayout.LayoutParams(dp(76), dp(76))
        pll.setMargins(dp(18), 0, dp(18), 0)
        play.setLayoutParams(pll)
        play.setOnClickListener(OnClickListener(lambda v: self._ui(self._player_toggle)))
        st["btn_play"] = play
        ctrl.addView(play)

        ctrl.addView(cbtn("⏭", lambda: self._player_step(1)))
        st["btn_repeat"] = cbtn("🔁", self._player_cycle_repeat, 18)
        ctrl.addView(st["btn_repeat"])
        root.addView(ctrl)

        # ---- lyrics ----
        lhead = TextView(ctx)
        lhead.setText("歌词")
        lhead.setTextSize(14)
        lhead.setTextColor(0xFF8A7B9C)
        lhead.setPadding(dp(4), dp(6), dp(4), dp(4))
        root.addView(lhead)

        scroll = ScrollView(ctx)
        sl2 = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, 0, 1.0)
        sl2.setMargins(0, dp(2), 0, 0)
        scroll.setLayoutParams(sl2)
        box = LinearLayout(ctx)
        box.setOrientation(LinearLayout.VERTICAL)
        box.setGravity(Gravity.CENTER_HORIZONTAL)
        box.setPadding(dp(8), dp(8), dp(8), dp(8))
        scroll.addView(box)
        empty = TextView(ctx)
        empty.setText("暂无歌词")
        empty.setTextSize(14)
        empty.setTextColor(0xFF8A7B9C)
        empty.setGravity(Gravity.CENTER)
        box.addView(empty)
        st["lyrics"] = empty
        st["lyrics_box"] = box
        st["lyric_views"] = []
        st["scroll"] = scroll
        root.addView(scroll)
        return root

    def _make_avatar_thumb(self, ctx):
        try:
            from android.graphics import Bitmap, Canvas, Color, Paint, Path, RectF
            from android.graphics.drawable import BitmapDrawable
            from org.telegram.ui import AndroidUtilities
            size = AndroidUtilities.dp(44)
            bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
            c = Canvas(bmp)
            c.drawColor(Color.TRANSPARENT)
            cx = size / 2.0
            cy = size / 2.0
            r = size * 0.40

            def paint(col):
                p = Paint()
                p.setColor(col)
                p.setAntiAlias(True)
                return p

            # cat ears
            ear_pink = paint(0xFFFF9EC7)
            inner_pink = paint(0xFFFFC7DD)
            for sx in (-1, 1):
                p = Path()
                bx = cx + sx * r * 0.55
                tipx = cx + sx * r * 0.95
                tipy = cy - r * 1.15
                p.moveTo(bx - sx * r * 0.25, cy - r * 0.55)
                p.lineTo(tipx, tipy)
                p.lineTo(bx + sx * r * 0.25, cy - r * 0.55)
                p.close()
                c.drawPath(p, ear_pink)
                p2 = Path()
                p2.moveTo(bx - sx * r * 0.12, cy - r * 0.62)
                p2.lineTo(cx + sx * r * 0.78, cy - r * 0.95)
                p2.lineTo(bx + sx * r * 0.12, cy - r * 0.62)
                p2.close()
                c.drawPath(p2, inner_pink)

            # face
            c.drawCircle(cx, cy, r, paint(0xFFFFE0C2))
            # hair top
            hair = paint(0xFFFFB7D5)
            c.drawArc(RectF(cx - r, cy - r * 1.05, cx + r, cy + r * 0.4), 180, 180, True, hair)

            # eyes
            eye = paint(0xFF4A3B5C)
            hl = paint(0xFFFFFFFF)
            for sx in (-1, 1):
                ex = cx + sx * r * 0.38
                ey = cy - r * 0.05
                c.drawOval(RectF(ex - r * 0.16, ey - r * 0.22, ex + r * 0.16, ey + r * 0.22), eye)
                c.drawCircle(ex - r * 0.06, ey - r * 0.08, r * 0.05, hl)
            # blush
            blush = paint(0xFFFF9EBB)
            for sx in (-1, 1):
                c.drawCircle(cx + sx * r * 0.62, cy + r * 0.18, r * 0.14, blush)
            # mouth
            mouth = paint(0xFFB56576)
            mouth.setStyle(Paint.Style.STROKE)
            mouth.setStrokeWidth(size * 0.035)
            c.drawArc(RectF(cx - r * 0.18, cy + r * 0.05, cx + r * 0.18, cy + r * 0.45), 20, 140, False, mouth)

            return BitmapDrawable(ctx.getResources(), bmp)
        except Exception:
            self._report("avatar_thumb")
            return None

    def _player_on_seek_change(self, prog, from_user):
        try:
            st = self._music_state
            if from_user:
                st["seeking"] = True
                # live-update time text while dragging
                from org.telegram.messenger import MediaController
                mc = MediaController.getInstance()
                cur = mc.getPlayingMessageObject()
                dur = mc.getDuration()
                if cur is not None and dur > 0:
                    est = int(dur * prog / 1000)
                    st["times"].setText("%s / %s" % (self._fmt_ms(est), self._fmt_ms(dur)))
        except Exception:
            pass

    def _player_on_seek_stop(self, prog):
        try:
            st = self._music_state
            st["seeking"] = False
            from org.telegram.messenger import MediaController
            mc = MediaController.getInstance()
            cur = mc.getPlayingMessageObject()
            dur = mc.getDuration()
            if cur is not None and dur > 0:
                ms = int(dur * prog / 1000)
                try:
                    mc.seekToProgressMs(cur, ms)
                except Exception:
                    try:
                        mc.seekToProgress(cur, prog / 1000.0)
                    except Exception:
                        pass
        except Exception:
            self._report("player_seek")

    def _player_toggle_shuffle(self):
        try:
            from org.telegram.messenger import SharedConfig
            val = not bool(getattr(SharedConfig, "shuffleMusic", False))
            SharedConfig.shuffleMusic = val
            self._music_state["shuffle"] = val
            self._player_update_toggle_icons()
        except Exception:
            # fallback: local shuffle flag only
            st = self._music_state
            st["shuffle"] = not bool(st.get("shuffle"))
            self._player_update_toggle_icons()

    def _player_cycle_repeat(self):
        st = self._music_state
        cur = int(st.get("repeat", 1))
        st["repeat"] = (cur + 1) % 3
        self._player_update_toggle_icons()

    def _player_update_toggle_icons(self):
        try:
            st = self._music_state
            sh = st.get("btn_shuffle")
            rp = st.get("btn_repeat")
            if sh is not None:
                on = bool(st.get("shuffle")) or self._read_shuffle()
                st["shuffle"] = on
                sh.setText("🔀")
                sh.setTextColor(0xFFFF6FA5 if on else 0xFFB9A8CC)
            if rp is not None:
                mode = int(st.get("repeat", 1))
                rp.setText("🔂" if mode == 2 else "🔁")
                rp.setTextColor(0xFFFF6FA5 if mode != 0 else 0xFFB9A8CC)
        except Exception:
            pass

    def _read_shuffle(self):
        try:
            from org.telegram.messenger import SharedConfig
            return bool(getattr(SharedConfig, "shuffleMusic", False))
        except Exception:
            return False

    def _player_restart(self):
        try:
            from org.telegram.messenger import MediaController
            mc = MediaController.getInstance()
            cur = mc.getPlayingMessageObject()
            if cur is not None:
                try:
                    mc.seekToProgress(cur, 0.0)
                except Exception:
                    pass
                mc.playMessage(cur)
        except Exception:
            pass

    def _player_load_playing(self):
        try:
            from org.telegram.messenger import MediaController
            mc = MediaController.getInstance()
            current = mc.getPlayingMessageObject()
            if current is not None:
                self._player_ensure_playlist(current)
                self._player_fetch_lyrics(current)
            self._player_update_toggle_icons()
        except Exception:
            self._report("player_load")

    def _player_ensure_playlist(self, current=None):
        st = self._music_state
        if st.get("playlist") is None:
            activity = self._music_active_chat()
            if activity is not None:
                st["playlist"] = self._music_collect(activity)
            else:
                st["playlist"] = []
        if current is not None and st["playlist"]:
            try:
                cid = current.getId()
                for i, m in enumerate(st["playlist"]):
                    if m.getId() == cid:
                        st["index"] = i
                        break
            except Exception:
                pass

    def _player_step(self, delta):
        st = self._music_state
        msgs = st.get("playlist") or []
        if not msgs:
            return
        idx = st.get("index", 0)
        idx = (idx + delta) % len(msgs)
        st["index"] = idx
        self._player_play_index(idx)

    def _player_play_index(self, idx):
        st = self._music_state
        msgs = st.get("playlist") or []
        if idx < 0 or idx >= len(msgs):
            return
        st["index"] = idx
        msg = msgs[idx]
        try:
            from java.util import ArrayList
            from org.telegram.messenger import MediaController
            arr = ArrayList()
            for m in msgs:
                arr.add(m)
            did = 0
            try:
                did = msg.getDialogId()
            except Exception:
                pass
            MediaController.getInstance().setPlaylist(arr, msg, did)
            self._player_fetch_lyrics(msg)
        except Exception as e:
            self._report("player_play_index: %s" % e)
            try:
                from org.telegram.messenger import MediaController
                MediaController.getInstance().playMessage(msg)
            except Exception:
                pass

    def _player_toggle(self):
        try:
            from org.telegram.messenger import MediaController
            mc = MediaController.getInstance()
            current = mc.getPlayingMessageObject()
            if current is None:
                idx = self._music_state.get("index", 0)
                self._player_play_index(idx)
                return
            if mc.isMessagePaused():
                mc.playMessage(current)
            else:
                mc.pauseMessage(current)
        except Exception:
            self._report("player_toggle")

    def _player_start_loop(self):
        try:
            st = self._music_state
            h = st.get("handler")
            if h is None:
                return
            runnable = st.get("runnable")
            if runnable is None:
                def loop():
                    try:
                        self._player_refresh()
                    except Exception:
                        pass
                    hh = st.get("handler")
                    if hh is not None and st.get("dialog") is not None:
                        hh.postDelayed(loop, 500)
                runnable = loop
                st["runnable"] = runnable
            h.removeCallbacks(runnable)
            h.postDelayed(runnable, 500)
        except Exception:
            self._report("player_loop")

    def _player_refresh(self):
        try:
            from org.telegram.messenger import MediaController
            st = self._music_state
            mc = MediaController.getInstance()
            current = mc.getPlayingMessageObject()
            playing = current is not None and not mc.isMessagePaused()
            self._player_set_spin(st, playing)
            title = self._music_title(current) if current is not None else "未在播放"
            st["song"].setText(title)
            artist = ""
            try:
                artist = current.getMusicPerformer() or ""
            except Exception:
                pass
            st["artist"].setText(artist)
            play = st.get("btn_play")
            if play is not None:
                play.setText("⏸" if playing else "▶")
            pos = dur = 0
            if current is not None:
                try:
                    pos = mc.getProgressMs(current)
                    dur = mc.getDuration()
                except Exception:
                    pass
            seeking = bool(st.get("seeking"))
            if not seeking:
                if dur > 0:
                    st["seek"].setProgress(int(pos * 1000 / dur))
                else:
                    st["seek"].setProgress(0)
                st["times"].setText("%s / %s" % (self._fmt_ms(pos), self._fmt_ms(dur)))
            # repeat-at-end handling
            if current is not None and playing and dur > 0:
                mode = int(st.get("repeat", 1))
                if pos >= dur - 400:
                    if not st.get("_end_fired"):
                        st["_end_fired"] = True
                        if mode == 2:
                            self._player_restart()
                        elif mode == 0:
                            try:
                                mc.pauseMessage(current)
                            except Exception:
                                pass
                else:
                    st["_end_fired"] = False
            self._player_update_lyrics(pos)
        except Exception:
            self._report("player_refresh")

    def _player_set_spin(self, st, spinning):
        try:
            disc = st.get("disc")
            anim = st.get("spin")
            if disc is None or anim is None:
                return
            if st.get("spinning") == spinning:
                return
            st["spinning"] = spinning
            if spinning:
                disc.startAnimation(anim)
            else:
                disc.clearAnimation()
        except Exception:
            pass

    @staticmethod
    def _fmt_ms(ms):
        try:
            ms = int(ms)
        except Exception:
            return "0:00"
        if ms < 0:
            ms = 0
        s = ms // 1000
        return "%d:%02d" % (s // 60, s % 60)

    # ---- lyrics (LRCLIB) ----

    def _player_fetch_lyrics(self, msg):
        title = self._music_title(msg)
        artist = ""
        try:
            artist = msg.getMusicPerformer() or ""
        except Exception:
            pass
        st = self._music_state
        st["lyric_lines"] = []
        st["lyric_idx"] = -1
        box = st.get("lyrics_box")
        if box is not None:
            self._ui(lambda: self._player_clear_lyrics("加载歌词…"))

        def work():
            try:
                import json
                import re
                import urllib.parse
                import urllib.request
                q = urllib.parse.urlencode({"track_name": title, "artist_name": artist})
                url = "https://lrclib.net/api/get?" + q
                with urllib.request.urlopen(url, timeout=8) as r:
                    data = json.loads(r.read().decode("utf-8"))
                synced = data.get("syncedLyrics") or ""
                plain = data.get("plainLyrics") or ""
                lines = []
                if synced:
                    for ln in synced.splitlines():
                        ln = ln.strip()
                        if not ln:
                            continue
                        m = re.match(r"\[(\d+):(\d+(?:\.\d+)?)\](.*)", ln)
                        if m:
                            mm = int(m.group(1))
                            ss = float(m.group(2))
                            txt = m.group(3).strip()
                            lines.append((int((mm * 60 + ss) * 1000), txt))
                self._ui(lambda ls=lines, pl=plain: self._player_set_lyrics(ls, pl))
            except Exception:
                self._ui(lambda: self._player_set_lyrics([], "暂无歌词"))
        import threading
        threading.Thread(target=work, daemon=True).start()

    def _player_clear_lyrics(self, text):
        try:
            from android.view import Gravity
            st = self._music_state
            box = st.get("lyrics_box")
            if box is None:
                return
            box.removeAllViews()
            tv = self._lyric_text_view(text, 0xFF8A7B9C, 14)
            tv.setGravity(Gravity.CENTER)
            box.addView(tv)
            st["lyrics"] = tv
            st["lyric_views"] = []
        except Exception:
            pass

    def _lyric_text_view(self, text, color, size):
        from android.view import Gravity
        from android.widget import TextView
        from org.telegram.ui import AndroidUtilities
        ctx = self._music_state.get("ctx") or self._music_active_ctx()
        tv = TextView(ctx)
        tv.setText(text)
        tv.setTextSize(size)
        tv.setTextColor(color)
        tv.setGravity(Gravity.CENTER)
        tv.setPadding(AndroidUtilities.dp(4), AndroidUtilities.dp(4), AndroidUtilities.dp(4), AndroidUtilities.dp(4))
        return tv

    def _music_active_ctx(self):
        try:
            from org.telegram.ui import LaunchActivity
            return LaunchActivity.instance
        except Exception:
            return None

    def _player_set_lyrics(self, lines, plain):
        try:
            from android.view import Gravity
            st = self._music_state
            st["lyric_lines"] = lines or []
            st["lyric_idx"] = -1
            box = st.get("lyrics_box")
            if box is None:
                return
            box.removeAllViews()
            views = []
            if lines:
                for ms, txt in lines:
                    tv = self._lyric_text_view(txt, 0xFF8A7B9C, 15)
                    box.addView(tv)
                    views.append(tv)
            else:
                tv = self._lyric_text_view(plain or "暂无歌词", 0xFF8A7B9C, 14)
                tv.setGravity(Gravity.CENTER)
                box.addView(tv)
            st["lyrics"] = box.getChildAt(0) if box.getChildCount() > 0 else None
            st["lyric_views"] = views
        except Exception:
            self._report("player_set_lyrics")

    def _player_update_lyrics(self, pos_ms):
        try:
            st = self._music_state
            lines = st.get("lyric_lines") or []
            views = st.get("lyric_views") or []
            if not lines or not views:
                return
            idx = -1
            for i, (t, _) in enumerate(lines):
                if t <= pos_ms:
                    idx = i
                else:
                    break
            if idx == st.get("lyric_idx"):
                return
            st["lyric_idx"] = idx
            # recolor
            for i, tv in enumerate(views):
                if i == idx:
                    tv.setTextColor(0xFFFF6FA5)
                    tv.setTextSize(17)
                else:
                    tv.setTextColor(0xFF8A7B9C)
                    tv.setTextSize(15)
            # auto-scroll to current line
            scroll = st.get("scroll")
            if scroll is not None and 0 <= idx < len(views):
                try:
                    v = views[idx]
                    top = v.getTop()
                    sh = scroll.getHeight()
                    lh = v.getHeight()
                    target = top - (sh - lh) // 2
                    if target < 0:
                        target = 0
                    scroll.smoothScrollTo(0, target)
                except Exception:
                    pass
        except Exception:
            pass

    # ---- helpers ----

    def _music_collect(self, activity):
        msgs = []
        try:
            raw = activity.messages
            size = raw.size() if hasattr(raw, "size") else len(raw)
            for i in range(size):
                msg = raw.get(i) if hasattr(raw, "get") else raw[i]
                if msg is None:
                    continue
                try:
                    if msg.isVoice() or msg.isMusic():
                        msgs.append(msg)
                except Exception:
                    pass
        except Exception:
            self._report("music_collect")
        return msgs

    def _music_title(self, msg):
        try:
            t = msg.getMusicTitle()
            if t:
                return t
        except Exception:
            pass
        try:
            return msg.messageOwner.message or "音频"
        except Exception:
            return "音频"
