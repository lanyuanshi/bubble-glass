    ("home", "主页", "org.telegram.ui.DialogsActivity", 26471),
    ("contacts", "联系人", "org.telegram.ui.ContactsActivity", 26472),
    ("settings", "设置", "org.telegram.ui.SettingsActivity", 26473),
)
